<script>
// ── CHART SPARKLINE ──────────────────────────────────────────
const ctx = document.getElementById('equityChart').getContext('2d');
const chartData = [0, 5, 3, 12, 8, 18, 15, 25, 22, 28, 24, 30, 28, 28.65];
const labels = chartData.map((_, i) => '');

const gradient = ctx.createLinearGradient(0, 0, 0, 80);
gradient.addColorStop(0, 'rgba(0,255,136,0.3)');
gradient.addColorStop(1, 'rgba(0,255,136,0)');

const chart = {
  canvas: document.getElementById('equityChart'),
  draw(data) {
    const c = this.canvas;
    const cx = c.getContext('2d');
    c.width = c.offsetWidth;
    c.height = 80;
    const w = c.width, h = c.height;
    const pad = 4;
    const min = Math.min(...data) - 5;
    const max = Math.max(...data) + 5;
    const toX = i => pad + (i / (data.length - 1)) * (w - 2 * pad);
    const toY = v => h - pad - ((v - min) / (max - min)) * (h - 2 * pad);
    cx.clearRect(0, 0, w, h);
    // fill
    cx.beginPath();
    cx.moveTo(toX(0), toY(data[0]));
    data.forEach((v, i) => i > 0 && cx.lineTo(toX(i), toY(v)));
    cx.lineTo(toX(data.length - 1), h);
    cx.lineTo(toX(0), h);
    cx.closePath();
    const grad = cx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, 'rgba(0,255,136,0.25)');
    grad.addColorStop(1, 'rgba(0,255,136,0)');
    cx.fillStyle = grad;
    cx.fill();
    // line
    cx.beginPath();
    cx.moveTo(toX(0), toY(data[0]));
    data.forEach((v, i) => i > 0 && cx.lineTo(toX(i), toY(v)));
    cx.strokeStyle = '#00ff88';
    cx.lineWidth = 2;
    cx.stroke();
    // last point dot
    const lx = toX(data.length-1), ly = toY(data[data.length-1]);
    cx.beginPath();
    cx.arc(lx, ly, 4, 0, Math.PI*2);
    cx.fillStyle = '#00ff88';
    cx.fill();
    // label
    cx.fillStyle = '#00ff88';
    cx.font = 'bold 10px Segoe UI';
    cx.fillText('+28.65%', lx - 42, ly - 8);
  }
};
chart.draw(chartData);
window.addEventListener('resize', () => chart.draw(chartData));

// ── COIN ICONS ───────────────────────────────────────────────
const coinEmoji = {
  BTC: '₿', ETH: '⟠', SOL: '◎', AVAX: '🔺', XRP: '✕',
  BNB: '🟡', ADA: '🔵', DOT: '🔴', MATIC: '🟣', DOGE: '🐕'
};
function getCoinIcon(symbol) {
  const coin = symbol.replace('USDT','').replace('USDC','');
  return coinEmoji[coin] || coin.charAt(0);
}

// ── HELPERS ──────────────────────────────────────────────────
function confBars(score, isWait) {
  const filled = Math.round((score / 100) * 5);
  let html = '<div class="conf-bars">';
  for (let i = 0; i < 5; i++) {
    const cls = i < filled ? (isWait ? 'yellow-on' : 'on') : 'off';
    html += `<div class="conf-bar-item ${cls}"></div>`;
  }
  return html + '</div>';
}
function dirBadge(dir) {
  const d = (dir||'').toUpperCase();
  if (d.includes('BUY') || d.includes('LONG')) return '<span class="badge-long">↗ LONG</span>';
  if (d.includes('SELL') || d.includes('SHORT')) return '<span class="badge-short">↘ SHORT</span>';
  return '<span class="badge-wait">↗ WAIT</span>';
}
function scoreColor(s) {
  if (s >= 80) return 'score-green';
  if (s >= 60) return 'score-yellow';
  return 'score-red';
}
function now() {
  return new Date().toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
}

// ── UPTIME ───────────────────────────────────────────────────
const startTime = Date.now();
function updateUptime() {
  const s = Math.floor((Date.now() - startTime) / 1000);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  document.getElementById('uptimeText').textContent =
    `Uptime: ${h}h ${m}m ${sec}s`;
}
setInterval(updateUptime, 1000);

// ── LOAD STATUS ──────────────────────────────────────────────
async function loadStatus() {
  try {
    const r = await fetch('/api/status');
    const d = await r.json();
    const prog = d.scan_progress || {};
    const pct = prog.pct || 0;
    const done = prog.done || 0;
    const total = prog.total || 300;

    document.getElementById('scanTitle').textContent =
      `Scanning ${done}/${total} Pair...`;
    document.getElementById('scanTime').textContent =
      `Last update: ${d.last_scan || '--'}`;
    document.getElementById('scanBar').style.width = pct + '%';
    document.getElementById('lastScanTime').textContent = d.last_scan || '--';

    // circle
    const offset = 113 - (pct / 100) * 113;
    document.getElementById('circleProgress').style.strokeDashoffset = offset;
    document.getElementById('circleText').textContent = Math.round(pct) + '%';

    // logs
    const logs = d.logs || [];
    const logEl = document.getElementById('activityLog');
    if (logs.length) {
      logEl.innerHTML = logs.slice(0, 5).map(l => `
        <div class="log-item">
          <div class="log-time">${l.time}</div>
          <div class="log-text">${l.icon || ''} ${l.message}</div>
        </div>
      `).join('');
    }
  } catch(e) {}
}

// ── LOAD SIGNALS ─────────────────────────────────────────────
async function loadSignals() {
  try {
    const r = await fetch('/api/signals');
    const signals = await r.json();
    const tbody = document.getElementById('signalBody');
    if (!signals || !signals.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#555;padding:20px;font-size:12px;">Menunggu sinyal...</td></tr>';
      return;
    }
    tbody.innerHTML = signals.slice(0, 6).map(s => {
      const sym = s.symbol || s.pair || '???';
      const dir = s.signal || s.direction || 'WAIT';
      const score = s.score || s.confidence || s.ai_score || 0;
      const isWait = dir.toUpperCase().includes('WAIT');
      const t = s.time || s.timestamp || now();
      const timeStr = typeof t === 'string' ? t.slice(-8) : now();
      return `
        <tr class="signal-row">
          <td>
            <span class="coin-icon">${getCoinIcon(sym)}</span>
            <span class="pair-name">${sym}</span><br>
            <span class="pair-sub" style="padding-left:32px">Perpetual</span>
          </td>
          <td>${dirBadge(dir)}</td>
          <td><span class="${scoreColor(score)}">${Math.round(score)}</span></td>
          <td>${confBars(score, isWait)}</td>
          <td><span class="time-text">${timeStr}</span></td>
        </tr>
      `;
    }).join('');
  } catch(e) {
    document.getElementById('signalBody').innerHTML =
      '<tr><td colspan="5" style="text-align:center;color:#555;padding:20px;font-size:12px;">Error memuat sinyal</td></tr>';
  }
}

// ── LOAD STATS ───────────────────────────────────────────────
async function loadStats() {
  try {
    const r = await fetch('/api/stats');
    const d = await r.json();
    const total = d.total || 0;
    const buy = d.buy || 0;
    const sell = d.sell || 0;
    const avgWr = d.avg_wr || d.avg_conf || 0;

    document.getElementById('openPos').textContent = `${buy} / ${total}`;
    document.getElementById('totalPos').textContent = `Total ${total} Position`;
    document.getElementById('portHeat').textContent = (avgWr || 0).toFixed(1) + '%';
    document.getElementById('winRate').textContent = avgWr.toFixed(1) + '%';
    document.getElementById('winCount').textContent = `${buy} / ${total}`;
    document.getElementById('totalPnl').textContent = `+${avgWr.toFixed(2)}%`;
    document.getElementById('profitFactor').textContent = total > 0 ? (buy / Math.max(sell, 1)).toFixed(2) : '0.00';
  } catch(e) {}
}

// ── REFRESH LOOP ─────────────────────────────────────────────
async function refresh() {
  await Promise.all([loadStatus(), loadSignals(), loadStats()]);
}

refresh();
setInterval(refresh, 10000);
</script>
