<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Scanner V6</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #0a0a0a;
    color: #e0e0e0;
    font-family: 'Segoe UI', Arial, sans-serif;
    min-height: 100vh;
    padding-bottom: 80px;
  }

  /* HEADER */
  .header {
    background: #111;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #222;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .header-logo { font-size: 26px; }
  .header-title { font-size: 18px; font-weight: 700; color: #fff; }
  .header-title span { color: #00ff88; }
  .header-sub { font-size: 11px; color: #666; }
  .online-badge {
    background: #0d2e1a;
    border: 1px solid #00ff88;
    color: #00ff88;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .online-dot {
    width: 7px; height: 7px;
    background: #00ff88;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%,100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .uptime { font-size: 10px; color: #555; text-align: right; margin-top: 2px; }

  /* STATS ROW */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 8px;
    padding: 12px 12px 0;
  }
  .stat-card {
    background: #161616;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 12px 10px;
  }
  .stat-label {
    font-size: 9px;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .stat-value {
    font-size: 18px;
    font-weight: 700;
    color: #00ff88;
    line-height: 1;
  }
  .stat-value.orange { color: #ff8c00; }
  .stat-value.red { color: #ff4444; }
  .stat-value.white { color: #fff; }
  .stat-sub { font-size: 10px; color: #555; margin-top: 4px; }
  .bullish-tag {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #00ff88;
    font-size: 13px;
    font-weight: 700;
  }
  .confidence-bar {
    height: 4px;
    background: #222;
    border-radius: 2px;
    margin-top: 6px;
  }
  .confidence-fill {
    height: 4px;
    background: #00ff88;
    border-radius: 2px;
    transition: width 0.5s;
  }

  /* SCAN PROGRESS */
  .scan-card {
    margin: 10px 12px 0;
    background: #161616;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .radar-icon {
    width: 44px; height: 44px;
    border: 2px solid #00ff88;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
    position: relative;
    animation: radar-spin 2s linear infinite;
  }
  @keyframes radar-spin {
    from { box-shadow: 0 0 0 0 rgba(0,255,136,0.4); }
    to { box-shadow: 0 0 0 12px rgba(0,255,136,0); }
  }
  .scan-info { flex: 1; }
  .scan-title { font-size: 13px; color: #00ff88; font-weight: 600; }
  .scan-sub { font-size: 10px; color: #555; margin-top: 2px; }
  .scan-bar-wrap { margin-top: 8px; height: 4px; background: #222; border-radius: 2px; }
  .scan-bar-fill { height: 4px; background: linear-gradient(90deg, #00ff88, #00ccff); border-radius: 2px; transition: width 0.5s; }
  .circle-progress {
    width: 44px; height: 44px;
    flex-shrink: 0;
  }
  .circle-bg { fill: none; stroke: #222; stroke-width: 4; }
  .circle-fg { fill: none; stroke: #00ff88; stroke-width: 4; stroke-linecap: round;
    stroke-dasharray: 113; stroke-dashoffset: 28;
    transform: rotate(-90deg); transform-origin: 50% 50%;
    transition: stroke-dashoffset 0.5s;
  }
  .circle-text { font-size: 11px; fill: #00ff88; font-weight: 700; text-anchor: middle; dominant-baseline: middle; }

  /* SIGNALS TABLE */
  .section {
    margin: 10px 12px 0;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .section-title {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.5px;
  }
  .see-all { font-size: 11px; color: #00ff88; }

  .signal-table { width: 100%; border-collapse: collapse; }
  .signal-table th {
    font-size: 9px;
    color: #444;
    text-transform: uppercase;
    padding: 0 6px 8px;
    text-align: left;
    letter-spacing: 0.5px;
  }
  .signal-row {
    background: #161616;
    border-radius: 10px;
    margin-bottom: 4px;
  }
  .signal-row td {
    padding: 10px 6px;
    font-size: 12px;
    border-bottom: 1px solid #1a1a1a;
  }
  .signal-row:last-child td { border-bottom: none; }
  .pair-name { font-weight: 700; color: #fff; font-size: 12px; }
  .pair-sub { font-size: 9px; color: #555; }
  .coin-icon {
    width: 26px; height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    margin-right: 6px;
    vertical-align: middle;
  }
  .badge-long {
    background: #0d2e1a;
    color: #00ff88;
    border: 1px solid #00ff88;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .badge-short {
    background: #2e0d0d;
    color: #ff4444;
    border: 1px solid #ff4444;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .badge-wait {
    background: #2a2200;
    color: #ffaa00;
    border: 1px solid #ffaa00;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .score-green { color: #00ff88; font-weight: 700; }
  .score-yellow { color: #ffaa00; font-weight: 700; }
  .score-red { color: #ff4444; font-weight: 700; }
  .conf-bars { display: flex; gap: 2px; align-items: center; }
  .conf-bar-item {
    width: 8px; height: 3px; border-radius: 2px;
  }
  .conf-bar-item.on { background: #00ff88; }
  .conf-bar-item.off { background: #333; }
  .conf-bar-item.yellow-on { background: #ffaa00; }
  .time-text { font-size: 10px; color: #555; }

  /* PERFORMA */
  .perf-card {
    background: #161616;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 14px;
  }
  .perf-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .perf-title { font-size: 13px; font-weight: 700; }
  .perf-period { font-size: 11px; color: #555; }
  .perf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .perf-item { }
  .perf-item-label { font-size: 9px; color: #555; text-transform: uppercase; letter-spacing: 0.5px; }
  .perf-item-value { font-size: 20px; font-weight: 700; color: #00ff88; margin-top: 2px; }
  .perf-item-value.red { color: #ff4444; }
  .perf-item-value.blue { color: #00aaff; }
  .perf-item-sub { font-size: 10px; color: #555; }

  /* CHART */
  .chart-wrap { position: relative; height: 80px; margin: 10px 0; }
  canvas#equityChart { width: 100% !important; height: 80px !important; }

  /* BOTTOM SECTIONS */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 10px 12px 0; }
  .mini-card {
    background: #161616;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 12px;
  }
  .mini-title { font-size: 11px; font-weight: 700; color: #fff; margin-bottom: 10px; }
  .log-item { margin-bottom: 8px; }
  .log-time { font-size: 10px; color: #555; }
  .log-text { font-size: 11px; color: #ccc; }
  .log-sub { font-size: 10px; color: #555; }

  .status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font-size: 11px;
  }
  .status-label { color: #888; display: flex; align-items: center; gap: 5px; }
  .status-ok { color: #00ff88; font-weight: 700; }
  .status-err { color: #ff4444; font-weight: 700; }

  /* BOTTOM NAV */
  .bottom-nav {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #111;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-around;
    padding: 10px 0 14px;
    z-index: 100;
  }
  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    color: #555;
    cursor: pointer;
  }
  .nav-item.active { color: #00ff88; }
  .nav-icon { font-size: 20px; }

  /* CONTROL BUTTONS */
  .ctrl-btns {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .btn-start {
    flex: 1;
    background: #00ff88;
    color: #000;
    border: none;
    padding: 10px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .btn-stop {
    flex: 1;
    background: #ff4444;
    color: #fff;
    border: none;
    padding: 10px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .btn-restart {
    flex: 1;
    background: #1a1a1a;
    color: #00aaff;
    border: 1px solid #00aaff;
    padding: 10px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }

  .divider { height: 1px; background: #1a1a1a; margin: 0 12px; }
  .section-card {
    background: #161616;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 14px;
  }
</style>
</head>
