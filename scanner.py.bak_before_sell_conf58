def simple_correlation_filter(signals):
    filtered = []
    seen = set()

    for s in signals:
        base = s["symbol"][:3]  # simple grouping BTC/ETH/etc
        if base in seen:
            continue
        seen.add(base)
        filtered.append(s)

    return filtered

