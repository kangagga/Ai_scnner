def scan_all_fast(symbols=None, timeframe="all", min_score=0):
    ctx = get_market_context()
    print(f"\n📊 Market Context: {ctx['summary']}")

    from risk_manager import print_risk_status
    print_risk_status()

    if symbols is None:
        try:
            new_listings    = get_new_listings()
            spike_pairs     = get_volume_spike_pairs(top_n=30)
            gainers, losers = get_top_gainers_losers(top_n=10)
            all_symbols     = fetch_symbols()
            combined = gainers + losers + new_listings + spike_pairs + WATCHLIST + all_symbols
            LEVERAGED_SUFFIXES = ("3L","5L","3S","5S","2L","2S","10L","10S")
            seen, symbols = set(), []
            for s in combined:
                if s not in seen:
                    seen.add(s)
                    base = s[:-4] if s.endswith("USDT") else s
                    if base.endswith(LEVERAGED_SUFFIXES):
                        continue
                    symbols.append(s)
            symbols = symbols[:PAIR_LIMIT]
        except Exception:
            symbols = WATCHLIST[:PAIR_LIMIT]

    tfs       = TIMEFRAMES if timeframe == "all" else [timeframe]
    tasks     = [(sym, tf) for sym in symbols for tf in tfs]
    total     = len(tasks)
    results   = []
    blocked   = 0
    completed = 0
    _block_counter.clear()

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as exe:
        futures = {
            exe.submit(_analyse_single, sym, tf, min_score): (sym, tf)
            for sym, tf in tasks
        }
        for fut in as_completed(futures):
            sym, tf = futures[fut]
            try:
                res = fut.result(timeout=TASK_TIMEOUT_SEC)
                if res:
                    sig = res["signal"]
                    if sig.startswith("BUY") and not ctx["allow_buy"]:
                        blocked += 1; continue
                    if sig.startswith("SELL") and not ctx["allow_sell"]:
                        blocked += 1; continue

                    res["fear_greed_value"] = ctx["fear_greed"]["value"]
                    res["fear_greed_label"] = ctx["fear_greed"]["label"]
                    res["fear_greed_emoji"] = ctx["fear_greed"]["emoji"]
                    res["btc_trend"]        = ctx["btc_trend"]["trend"]
                    res["btc_trend_emoji"]  = ctx["btc_trend"]["emoji"]
                    results.append(res)

            except Exception as e:
                logger.debug(f"[SKIP] {sym}/{tf}: {e}")
            finally:
                completed += 1
                if completed % 10 == 0 or completed == total:
                    print(f"   Progress: {completed}/{total} — sinyal: {len(results)} | blokir: {blocked}")

    _total_filtered = sum(_block_counter.values())
    logger.info(f"✅ Scan selesai — {len(results)} sinyal lolos | {blocked} diblokir (bias) | {_total_filtered} difilter lainnya")
    if _block_counter:
        _breakdown = " | ".join(f"{k}:{v}" for k, v in _block_counter.most_common())
        logger.info(f"📋 Breakdown filter: {_breakdown}")
    return results


def get_dynamic_threshold(ctx, signal_type=None):
    """
    Auto-Adaptive Threshold berdasarkan:
    - BTC Trend (UPTREND/SIDEWAYS/DOWNTREND/DUMP)
    - Fear & Greed Index
    - Win Rate realtime
    - Signal type (BUY lebih ketat saat downtrend)
    """
    from config import SIGNAL_THRESHOLD
    base = SIGNAL_THRESHOLD

    # ── Win Rate Adjustment ──
    try:
        from database import get_realtime_winrate
        wr_data   = get_realtime_winrate()
        actual_wr = wr_data.get("win_rate", 0)
        total     = wr_data.get("total", 0)
        if total >= 10:
            if actual_wr >= 70: base -= 5
            elif actual_wr >= 60: base -= 2
            elif actual_wr < 45: base += 8
            elif actual_wr < 55: base += 4
    except Exception:
        pass

    # ── Fear & Greed Adjustment ──
    fg_raw = ctx.get("fear_greed", 50)
    fg = fg_raw.get("value", 50) if isinstance(fg_raw, dict) else int(fg_raw)
    if fg <= 15:
        base += 5   # Extreme Fear → lebih selektif
    elif fg <= 25:
        base += 3   # Fear
    elif fg >= 80:
        base += 5   # Greed berlebihan → hati-hati
    elif fg >= 60:
        base -= 2   # Optimis → sedikit longgarkan

    # ── BTC Trend Auto-Adaptive ──
    btc_raw = ctx.get("btc_trend", "")
    btc = btc_raw.get("trend", "") if isinstance(btc_raw, dict) else str(btc_raw)
    btc_upper = btc.upper()

    # Deteksi kondisi BTC
    is_strong_up   = "STRONG" in btc_upper and "UP" in btc_upper
    is_uptrend     = "UP" in btc_upper and "STRONG" not in btc_upper
    is_sideways    = "SIDEWAYS" in btc_upper or "NEUTRAL" in btc_upper
    is_weak        = "WEAK" in btc_upper
    is_downtrend   = "DOWN" in btc_upper and "STRONG" not in btc_upper
    is_strong_down = "STRONG" in btc_upper and "DOWN" in btc_upper
    is_dump        = "DUMP" in btc_upper or "CRASH" in btc_upper

    if is_dump:
        # DUMP → semua sinyal diblok
        base = 999
        logger.warning(f"[THRESHOLD] BTC DUMP terdeteksi — semua sinyal diblok!")
    elif is_strong_down:
        # Strong Downtrend → BUY diblok, SELL threshold rendah
        if signal_type and "BUY" in str(signal_type).upper():
            base = 999
            logger.info(f"[THRESHOLD] BTC STRONG DOWNTREND — BUY diblok")
        else:
            base -= 5  # SELL lebih mudah lolos
    elif is_downtrend:
        # Downtrend Moderate → BUY threshold sangat tinggi
        if signal_type and "BUY" in str(signal_type).upper():
            base += 20  # BUY butuh score sangat tinggi
            logger.info(f"[THRESHOLD] BTC DOWNTREND — BUY threshold dinaikkan ke {base}")
        else:
            base -= 3  # SELL lebih mudah
    elif is_sideways or is_weak:
        # Sideways/Weak → perketat semua
        base += 8
    elif is_uptrend:
        # Uptrend normal → standard
        base -= 3
    elif is_strong_up:
        # Strong Uptrend → longgarkan
        base -= 8

    base = max(30, min(95, base))
    logger.info(f"[THRESHOLD] Auto-Adaptive: {base} (F&G={fg}, BTC={btc}, Signal={signal_type})")
    return base


def _correlation_filter(signals: list, max_same_direction: int = 5) -> list:
    """Batasi sinyal searah — hindari kirim 10 BUY sekaligus."""
    buy_count = sell_count = 0
    filtered  = []
    for s in signals:
        sig = s.get("signal", "")
        if sig.startswith("BUY"):
            if buy_count >= max_same_direction:
                continue
            buy_count += 1
        elif sig.startswith("SELL"):
            if sell_count >= max_same_direction:
                continue
            sell_count += 1
        filtered.append(s)
    return filtered


def get_top_signals(results, top_n=5, threshold=0):
    if not results:
        return []
    df = pd.DataFrame(results)
    df = df[df["signal"].isin(VALID_SIGNALS)]
    if threshold > 0:
        df = df[df["confidence"] >= threshold]
    if df.empty:
        return []
    df = df.sort_values("confidence", ascending=False)
    df = df.drop_duplicates(subset=["symbol", "timeframe"], keep="first")
    records = df.head(top_n * 2).to_dict("records")
    records = _correlation_filter(records, max_same_direction=3)
    return records[:top_n]

