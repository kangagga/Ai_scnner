    try:
        from market_context import detect_market_regime
        _reg_info = detect_market_regime(symbol, timeframe)
        _regime   = _reg_info.get("regime", "NEUTRAL")

        # Multiplier per regime, dibedakan arah sinyal
        ADAPTIVE_MULT = {
            "TRENDING": {"BUY": 1.15, "SELL": 1.15},   # tren kuat — boost ikut arah
            "BREAKOUT": {"BUY": 1.25, "SELL": 1.10},   # breakout — boost breakout BUY lebih besar
            "RANGING":  {"BUY": 0.85, "SELL": 0.85},   # sideways — kurangi confidence trend-following
            "VOLATILE": {"BUY": 0.70, "SELL": 0.70},   # volatil ekstrem — sangat hati-hati
            "NEUTRAL":  {"BUY": 1.00, "SELL": 1.00},
            "UNKNOWN":  {"BUY": 0.50, "SELL": 0.50},   # data tidak jelas — sangat dikurangi
        }
        # [DISABLED 2026-07-03] ADAPTIVE_MULT dimatikan — redundant dengan blokir regime
        # NEUTRAL/VOLATILE/UNKNOWN + regime_min_conf yang sudah ada di bawah.
        # Terlalu banyak lapis filter regime bikin sinyal jarang lolos.
        _direction = "BUY" if signal.startswith("BUY") else "SELL"
        # _mult = ADAPTIVE_MULT.get(_regime, {}).get(_direction, 1.0)
        # confidence_before_adaptive = confidence
        # confidence = round(confidence * _mult, 1)
        # logger.debug(
        #     f"[ADAPTIVE] {symbol}/{timeframe} regime={_regime} dir={_direction} "
        #     f"mult={_mult}x conf {confidence_before_adaptive:.1f}→{confidence:.1f}"
        # )
    except Exception as _e:
        logger.debug(f"[ADAPTIVE] error — {_e}")

    # Min confidence per signal type
    MIN_CONF = {
        "BUY"            : 68,
        "SELL"           : 65,
        "BUY (SETUP)"    : 50,
        "SELL (SETUP)"   : 50,
        "BUY (REVERSAL)" : 55,
        "SELL (REVERSAL)": 50,
    }
    if confidence < MIN_CONF.get(signal, 35):
        logger.debug(f"[MINCONF] {symbol}/{timeframe}: {signal} conf={confidence} < min={MIN_CONF.get(signal, 35)}, skip")
        _bump_block("MINCONF")
        return None

    if confidence < min_score:
        logger.debug(f"[MINSCORE] {symbol}/{timeframe}: conf={confidence} < min_score={min_score}, skip")
        _bump_block("MINSCORE")
        return None
    # Market regime filter
    try:
        from market_context import detect_market_regime
        regime = detect_market_regime(symbol, timeframe)
        reg    = regime.get("regime", "NEUTRAL")

        # [UPDATED 2026-07-04] NEUTRAL tidak lagi diblokir total.
        # Analisis funnel: 11/12 sinyal SETUP historis BTCUSDT jatuh ke NEUTRAL
        # akibat celah logika (ADX 20-22 tidak match TRENDING maupun RANGING,
        # atau bb_width tidak capai threshold meski ADX sudah rendah).
        # Blokir keras NEUTRAL menggugurkan sinyal valid yang cuma "salah kategori regime".
        # Solusi: NEUTRAL tetap boleh lolos tapi dengan MIN_CONF lebih tinggi (60),
        # bukan diblokir total. VOLATILE & UNKNOWN tetap diblokir keras (WR 0% & data tidak jelas).
        if reg in ("VOLATILE", "UNKNOWN"):
            logger.debug(f"[REGIME] {symbol}/{timeframe}: regime {reg} diblokir")
            _bump_block(f"REGIME_{reg}")
            return None

        regime_min_conf = {
            "TRENDING" : 50,
            "BREAKOUT" : 55,
            "RANGING"  : 48,
            "NEUTRAL"  : 60,  # lebih ketat karena data historis WR NEUTRAL rendah (~30%)
        }.get(reg, 50)

        if confidence < regime_min_conf:
            logger.debug(f"[REGIME] {symbol}/{timeframe}: conf={confidence} < {regime_min_conf} ({reg}), skip")
            _bump_block("REGIME_MINCONF")
            return None

        if reg == "TRENDING":
