    # RANGING bisa lebih sempit karena gerak harga terbatas
    ADAPTIVE_SL_MULT = {
        "TRENDING": 1.5,
        "BREAKOUT": 1.6,
        "RANGING":  1.2,
        "VOLATILE": 2.0,
        "NEUTRAL":  1.5,
        "UNKNOWN":  1.5,
