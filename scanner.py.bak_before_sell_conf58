        "stoch_k"            : round(_safe(last.get("stoch_k", 0)), 2),
        "adx"                : round(_safe(last.get("adx", 0)), 2),
        "squeeze_score"      : round(_safe(last.get("squeeze_score", 0)), 1),
        "ema_trend"          : ema_trend,
        "momentum_score"     : 0,
        "win_rate"           : 0,
        "fear_greed_value"   : 0,
        "fear_greed_label"   : "",
        "fear_greed_emoji"   : "",
        "btc_trend"          : "",
        "btc_trend_emoji"    : "",
        "funding_rate"       : "",
        "funding_rate_label" : "N/A",
        "funding_rate_emoji" : "❓",
        "regime"             : reg if "reg" in dir() else "NEUTRAL",
